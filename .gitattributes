# Keep the distributed package to what a consumer actually runs. Everything
# below is development tooling; it stays in the git repository but is stripped
# from the dist archive Composer downloads.
#
# Deliberately still shipped: bin/, src/, composer.json, LICENSE, README.md and
# CHANGELOG.md — the changelog is how someone on a server works out what their
# installed version contains.
/.github            export-ignore
/tests              export-ignore
/phpunit.xml        export-ignore
/phpstan.neon       export-ignore
/phpstan-baseline.neon export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
